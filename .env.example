VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional. If set, game search uses RAWG first, then CheapShark.
VITE_RAWG_API_KEY=
# GitHub Pages reads .env.production at build time (anon key is public).
# You can also set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY as Actions secrets.
