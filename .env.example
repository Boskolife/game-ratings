VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional. If set, game search uses RAWG first, then CheapShark.
VITE_RAWG_API_KEY=
# Local only: copy this file to .env
# GitHub Pages: set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY as Actions secrets.
